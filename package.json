{
  "name": "risklab",
  "private": true,
  "version": "0.2.0",
  "description": "Investor-friendly portfolio risk analysis with plain-English explanations, stress scenarios, and long-term simulations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist/client && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server/server.cjs",
    "start": "node dist/server/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:quant": "tsx tests/quantEngine.test.ts",
    "check": "npm run lint && npm run test:quant",
    "generate:icons": "node scripts/generate-pngs.js",
    "build:cloudflare": "vite build --outDir dist/client && esbuild worker.ts --bundle --platform=browser --format=esm --conditions=browser --target=es2022 --outfile=dist/server/index.js",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy",
    "test:ai": "node --import tsx tests/workersAi.test.ts",
    "refresh:symbols": "node scripts/update-symbol-directory.mjs",
    "test:symbols": "node --import tsx tests/symbolDirectory.test.ts"
  },
  "keywords": [
    "portfolio-risk",
    "quantitative-finance",
    "monte-carlo",
    "value-at-risk",
    "stress-testing",
    "react",
    "typescript",
    "gemini"
  ],
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
